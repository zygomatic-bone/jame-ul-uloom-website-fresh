# Root routing and security headers for jameululoom.org (generated by tools/generate_portal.py). The Residential School folder adds its own
# stricter rules in ResidentialSchoolBanikuppa/.htaccess; the legacy-URL redirects of the earlier site address follow below.
Options -Indexes

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://i.ytimg.com https://i1.ytimg.com https://i2.ytimg.com https://i3.ytimg.com https://i4.ytimg.com https://img.youtube.com; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src https://www.youtube-nocookie.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Ask search engines not to list photographs of pupils and staff in image search (same policy as the Residential School)
  <FilesMatch "\.(jpe?g|png|gif|webp)$">
    Header set X-Robots-Tag "noimageindex"
  </FilesMatch>
</IfModule>

# Never serve dotfiles, backups, logs, source maps or build leftovers if one is ever uploaded by mistake
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|\.(bak|old|orig|swp|sql|log|ini|env|map|py|sh|md)$|~$)">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^home(\.html)?/?$ / [R=301,L]
